# кэш ответов API — восстанавливается сам
app/.cache/

# личный токен STRATZ: в репозиторий никогда, в CI он лежит в секретах
stratz_token.txt

# эталонные портреты героев: это изображения Valve, распространять их
# в репозитории не нужно. Приложение качает их само при первом запуске
# кнопкой «Скачать портреты».
app/assets/

__pycache__/
*.py[cod]
.DS_Store

# настройки IDE
.idea/
.vscode/

# распакованные копии снимков: в репозитории только .gz
app/data/*.json
!app/data/positions.json

# скриншоты и картинки, брошенные в корень проекта, в репозиторий не нужны
/*.jpg
/*.jpeg
/*.png
